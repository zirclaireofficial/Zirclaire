# Zirclaire — environment variables (template)
# Copy this file to `.env` and fill in the real values. Never commit `.env`.

# --- Supabase ---
# Dashboard: Project Settings > API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# "publishable" key (sb_publishable_...) — safe to expose to the browser (limited by RLS)
SUPABASE_KEY=your-publishable-key
# "secret" key (sb_secret_...) — SERVER ONLY. Full DB access, bypasses RLS.
# Never expose this to the client. Used only in /server routes.
NUXT_SUPABASE_SECRET_KEY=your-secret-key

# --- Cloudinary ---
# Dashboard: Settings > API Keys (Cloud name shown at top)
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# SERVER ONLY — used to sign uploads. Never expose to the browser.
CLOUDINARY_API_SECRET=your-api-secret
